{
  "id": "vida-2-0-api",
  "name": "Vida 2.0 API",
  "description": "Closed, typed bridge from one isolated local Vida agent to the private Vida 2.0 OpenClaw API.",
  "version": "0.1.0",
  "activation": {
    "onStartup": false,
    "onCapabilities": ["tool"]
  },
  "contracts": {
    "tools": ["vida_operation"]
  },
  "toolMetadata": {
    "vida_operation": {
      "optional": true
    }
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        { "path": "agents.steward.keyId", "expected": "string" },
        { "path": "agents.steward.secret", "expected": "string" },
        { "path": "agents.health-reflection.keyId", "expected": "string" },
        { "path": "agents.health-reflection.secret", "expected": "string" },
        { "path": "agents.digital-order.keyId", "expected": "string" },
        { "path": "agents.digital-order.secret", "expected": "string" },
        { "path": "agents.technical-guardian.keyId", "expected": "string" },
        { "path": "agents.technical-guardian.secret", "expected": "string" }
      ]
    }
  },
  "uiHints": {
    "baseUrl": {
      "label": "Vida base URL",
      "help": "Vida origin only, for example https://vida.example.com. No path, no query string.",
      "placeholder": "https://vida.example.com"
    },
    "agents": {
      "label": "Per-agent Vida credentials",
      "help": "One keyId/secret pair per Vida agent this OpenClaw install binds to. Configure as SecretRefs, never as literal values.",
      "sensitive": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["baseUrl"],
    "properties": {
      "baseUrl": {
        "type": "string",
        "minLength": 1
      },
      "agents": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "steward": { "$ref": "#/$defs/agentCredential" },
          "health-reflection": { "$ref": "#/$defs/agentCredential" },
          "digital-order": { "$ref": "#/$defs/agentCredential" },
          "technical-guardian": { "$ref": "#/$defs/agentCredential" }
        }
      }
    },
    "$defs": {
      "agentCredential": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "secret"],
        "properties": {
          "keyId": { "type": "string", "minLength": 1 },
          "secret": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
