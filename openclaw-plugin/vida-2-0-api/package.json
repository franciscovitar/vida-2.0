{
  "name": "@vida-2-0/openclaw-plugin-vida-2-0-api",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical native OpenClaw plugin bridging one isolated local Vida agent to the private Vida 2.0 OpenClaw API.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc",
    "test:core": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:integration": "node --import tsx --test \"src/**/*.integration.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "typebox": "1.1.39"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "6.0.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/adapter/plugin.js"
    ]
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ]
}
