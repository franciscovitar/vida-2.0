# Vida 2.0 — variables de entorno (ejemplo)
#
# Copia este archivo a `.env.local` y completa los valores reales.
# `.env.local` está ignorado por Git y NUNCA debe subirse al repositorio.
# Todas estas variables se usan solo en el servidor: claves, tokens y secretos
# nunca deben llegar al navegador ni al bundle del cliente.
#
# --- Clasificación para Vercel (Fase 7A / Preview) ---
# Preview / Production futura: configurar en el panel de Vercel (valores reales).
# Solo desarrollo local: NO configurar en Vercel.
# Opcionales: solo si se necesita diagnóstico local.
# Nunca subir a Vercel: redirect URI local de Calendar OAuth, traces, tokens temporales.
#
# No inventar AUTH_URL / NEXTAUTH_URL: Auth.js v5 con AUTH_TRUST_HOST=true
# resuelve el host de la petición (localhost o *.vercel.app).

# =============================================================================
# Google Sheets (DEV / Preview / Production)
# =============================================================================
# Origen de datos: "mock" (por defecto en local) o "google".
DATA_SOURCE=mock

# Cuenta de servicio de Google (solo servidor). Lectura en DEV y canónico;
# escritura de hábitos seg—n target + allow (ver abajo).
GOOGLE_SERVICE_ACCOUNT_EMAIL=vida-2-0-dev@tu-proyecto.iam.gserviceaccount.com

# Clave privada de la cuenta de servicio (una sola línea con \n).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...clave-de-ejemplo...\n-----END PRIVATE KEY-----\n"

# Target del Sheet: "dev" | "prod".
# Local y Vercel Preview ? siempre "dev".
# Vercel Production (corte futuro) ? "prod".
# Si está ausente y existe GOOGLE_SHEETS_DEV_ID, se usa "dev" (compatibilidad temporal).
# Nunca resolver implícitamente a "prod".
GOOGLE_SHEETS_TARGET=dev

# IDs de ejemplo (reemplazar en .env.local / Vercel; nunca hardcodear en código).
GOOGLE_SHEETS_DEV_ID=ejemplo_dev
GOOGLE_SHEETS_PROD_ID=ejemplo_prod

# Escrituras en el Sheet canónico (target=prod). Exactamente "true" para habilitar.
# Local/Preview: false. Production: true solo después de backup, Editor y validación.
# No afecta escrituras cuando target=dev.
GOOGLE_SHEETS_ALLOW_PROD_WRITES=false

# Spreadsheet dedicado de Gimnasio (solo servidor; puede variar por entorno).
GOOGLE_GYM_SPREADSHEET_ID=ejemplo_gym

# Compuerta adicional para escrituras de Gimnasio. Solo el literal exacto true habilita.
# Mantener false hasta validar explícitamente target, permisos y Safe Writes.
GOOGLE_GYM_SHEETS_ALLOW_WRITES=false

# Store cuantitativo dedicado de Nutrition Intelligence (solo lectura en Nutrition V2).
# No reutiliza implícitamente el Sheet general ni el de Gimnasio.
GOOGLE_NUTRITION_SPREADSHEET_ID=ejemplo_nutrition_store

# =============================================================================
# Notion — solo lectura (Preview + Production futura)
# =============================================================================
# Origen: "mock" (por defecto) o "notion".
NOTION_DATA_SOURCE=mock

# Token de integración interna (solo servidor).
NOTION_API_TOKEN=secret_ejemplo_no_usar_en_produccion

# Data source IDs canónicos (lista blanca): Tareas / Proyectos / Áreas.
NOTION_TASKS_DATA_SOURCE_ID=ejemplo_tasks_data_source
NOTION_PROJECTS_DATA_SOURCE_ID=ejemplo_projects_data_source
NOTION_AREAS_DATA_SOURCE_ID=ejemplo_areas_data_source

# Data source ID canónico de `Hitos de proyecto` (lista blanca dedicada de
# Projects Intelligence; reutiliza NOTION_PROJECTS_DATA_SOURCE_ID y
# NOTION_TASKS_DATA_SOURCE_ID de arriba). Solo lectura.
NOTION_MILESTONES_DATA_SOURCE_ID=ejemplo_milestones_data_source

# =============================================================================
# Google Calendar — solo lectura (Preview + Production futura)
# =============================================================================
# Origen: "mock" (por defecto) o "google".
# OAuth INDEPENDIENTE del login de Auth.js. No reutilices AUTH_GOOGLE_*.
GOOGLE_CALENDAR_DATA_SOURCE=mock

GOOGLE_CALENDAR_CLIENT_ID=1234567890-calendar.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=ejemplo_calendar_client_secret_no_real

# Refresh token ya obtenido offline (runtime). Solo servidor.
GOOGLE_CALENDAR_REFRESH_TOKEN=ejemplo_refresh_token_no_real

# Lista de calendar IDs autorizados (sin descubrimiento global).
GOOGLE_CALENDAR_IDS=primary

GOOGLE_CALENDAR_TIMEZONE=America/Argentina/Cordoba

# --- Solo desarrollo local (NO configurar en Vercel) ---
# Usada únicamente por /api/calendar/oauth/start y /callback para obtener el
# refresh token en localhost. Esas rutas están bloqueadas en production/VERCEL
# y fuera de localhost/127.0.0.1. El runtime de lectura Calendar NO la necesita.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/oauth/callback

# Modo del consentimiento OAuth local de Calendar. Solo lo lee la ruta start local.
#   vacío / ausente / cualquier otro valor => readonly (default seguro)
#   hold-write => flujo local manual para Calendar Hold; solicita SOLO tres scopes:
#     calendar.events.readonly, calendar.events.owned, calendar.calendars.readonly
# No se infiere de WRITE_ACTIONS_ENABLED, GOOGLE_CALENDAR_WRITE_ID ni del entorno.
GOOGLE_CALENDAR_OAUTH_MODE=

# =============================================================================
# Auth.js / Google login (Preview + Production futura)
# =============================================================================
# Cliente OAuth Web INDEPENDIENTE del cliente de Calendar.
# Scopes de login: openid email profile (sin Calendar ni offline).
# Genera AUTH_SECRET con: npx auth secret
AUTH_SECRET=ejemplo_auth_secret_cambiar_en_local
AUTH_GOOGLE_ID=1234567890-login.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=ejemplo_auth_google_secret_no_real

# Lista de correos autorizados (coma, trim, lowercase; sin vacíos ni duplicados).
# No revelar estos valores en UI, logs ni commits.
AUTH_ALLOWED_EMAILS=usuario.autorizado@example.com,otro.autorizado@example.com

# trustHost de Auth.js. Usar true en:
# - desarrollo local (localhost);
# - Preview Vercel;
# - Production futura.
# Evita UntrustedHost detrás del proxy de Vercel / host headers.
AUTH_TRUST_HOST=true

# =============================================================================
# Registro Web (Preview + Production futura)
# =============================================================================
# Exactamente true habilita catálogo, rutas documentales y búsqueda.
# Ausente o cualquier valor distinto del literal exacto "true" => desactivado.
WEB_CATALOG_ENABLED=false

# Data source ID del Registro Web (solo servidor; sin valor en el repo).
# Obligatorio unicamente si WEB_CATALOG_ENABLED=true.
NOTION_WEB_CATALOG_DATA_SOURCE_ID=ejemplo_catalog_data_source

# Token opcional de una integración documental dedicada y de solo lectura.
# Si está ausente se usa NOTION_API_TOKEN por compatibilidad.
NOTION_WEB_CATALOG_API_TOKEN=secret_ejemplo_catalogo_solo_lectura

# En Vercel Preview deben permanecer apagadas:
# WRITE_ACTIONS_ENABLED=false
# OPENCLAW_API_ENABLED=false


# No configurar GOOGLE_CALENDAR_REDIRECT_URI, WRITE_ACTIONS_USE_MEMORY ni flags de tests.

# CALENDAR_TRACE_STAGES=1

# =============================================================================
# Escrituras seguras / Policy Engine (8E) — solo servidor
# =============================================================================
# Exactamente "true" habilita Server Actions de escritura. Default: apagado.
# No configurar en Vercel hasta validación expl—cita. Nunca exponer al cliente.
WRITE_ACTIONS_ENABLED=false

# Captura conversacional directa de Bandeja. Requiere además WRITE_ACTIONS_ENABLED=true.
# Mantener false hasta que exista y se valide el adapter autenticado ChatGPT → Vida.
CONVERSATIONAL_INBOX_DIRECT_APPLY_ENABLED=false

# Memoria solo para tests locales. Exactamente true. Nunca en Preview/Production.
WRITE_ACTIONS_USE_MEMORY=false

# Coordinacion: unavailable | memory-test | upstash. Default seguro: unavailable.
WRITE_COORDINATION_MODE=unavailable

# TTL de propuesta pending / ciphertext (segundos). Default 24h.
WRITE_APPROVAL_TTL_SECONDS=86400

# Ventana de rollback tras applied (segundos). Default 7 dias.
WRITE_ROLLBACK_WINDOW_SECONDS=604800

# Version de contrato de escrituras (namespace + ledger).
WRITE_CONTRACT_VERSION=vida2-writes-v1

# Clave AES-256-GCM (32 bytes en base64). Sin valor en el repo.
# WRITE_PROPOSAL_ENCRYPTION_KEY=

# Calendar ID autorizado solo para holds (escritura). Sin valor en el repo.
# GOOGLE_CALENDAR_WRITE_ID=

# P—gina Notion de Bandeja (captura). Sin valor = estado controlado.
# NOTION_INBOX_PAGE_ID=

# Propiedad rich_text de ownership en Tareas (default: Vida2 Ownership).
# NOTION_TASK_OWNERSHIP_PROPERTY=Vida2 Ownership

# Data source Notion de Acciones y propuestas.
# NOTION_ACTIONS_DATA_SOURCE_ID=

# Rangos A1 de pesta—as Gym Sessions / Gym Sets (spreadsheet dedicado de Gimnasio).
# SHEETS_GYM_SESSIONS_RANGE=
# SHEETS_GYM_SETS_RANGE=

# =============================================================================
# OpenClaw API (8F.1) - solo servidor
# =============================================================================
# Exactamente \"true\" habilita /api/openclaw/v1/*. Default: apagado.
# Requiere además OPENCLAW_ACCESS_MODE=read-only.
# No configurar en Vercel hasta validación explícita. Nunca exponer al cliente.
OPENCLAW_API_ENABLED=false

# Exactamente true habilita propuestas OpenClaw pending (sin approve/execute).
OPENCLAW_PROPOSALS_ENABLED=false


# Contrato canónico: disabled | read-only | full.
# Bloque 2 acepta únicamente read-only. full queda reservado y falla cerrado.
OPENCLAW_ACCESS_MODE=disabled

# Identificador y secreto HMAC (solo servidor). Sin valores en el repo.
# OPENCLAW_API_KEY_ID=
# OPENCLAW_API_SECRET=

# Límite por minuto. En Preview/Production, los dos modos deben ser "upstash".
# "memory" se admite únicamente en tests o desarrollo local explícito.
# OPENCLAW_API_RATE_PER_MINUTE=60
# OPENCLAW_RATE_LIMIT_MODE=upstash
# OPENCLAW_REPLAY_MODE=upstash

# =============================================================================
# Controlled Automations (Block 5) - server only, disabled by default
# =============================================================================
# Global gate and closed access contract: disabled | read-only | proposal-only.
AUTOMATIONS_API_ENABLED=false
AUTOMATIONS_SCHEDULE_INGRESS_ENABLED=false
AUTOMATIONS_ACCESS_MODE=disabled
AUTOMATIONS_WORKFLOW_CONTRACT_VERSION=vida2-automations-v1
# Production requires a separate explicit authorization; local/Preview never imply it.
AUTOMATIONS_PRODUCTION_ENABLED=false

# Per-workflow kill switches. Every workflow remains off until explicitly enabled.
AUTOMATIONS_DAILY_BRIEFING_ENABLED=false
AUTOMATIONS_TECHNICAL_WATCHDOG_ENABLED=false
AUTOMATIONS_WEEKLY_REVIEW_ENABLED=false
AUTOMATIONS_APPROVAL_DIGEST_ENABLED=false
AUTOMATIONS_PLANNING_SUGGESTION_ENABLED=false

# One independent HMAC key/secret pair per workflow principal. Server only.
# OPENCLAW_AUTOMATION_DAILY_BRIEFING_API_KEY_ID=
# OPENCLAW_AUTOMATION_DAILY_BRIEFING_API_SECRET=
# OPENCLAW_AUTOMATION_TECHNICAL_WATCHDOG_API_KEY_ID=
# OPENCLAW_AUTOMATION_TECHNICAL_WATCHDOG_API_SECRET=
# OPENCLAW_AUTOMATION_WEEKLY_REVIEW_API_KEY_ID=
# OPENCLAW_AUTOMATION_WEEKLY_REVIEW_API_SECRET=
# OPENCLAW_AUTOMATION_APPROVAL_DIGEST_STEWARD_API_KEY_ID=
# OPENCLAW_AUTOMATION_APPROVAL_DIGEST_STEWARD_API_SECRET=
# OPENCLAW_AUTOMATION_APPROVAL_DIGEST_HEALTH_API_KEY_ID=
# OPENCLAW_AUTOMATION_APPROVAL_DIGEST_HEALTH_API_SECRET=
# OPENCLAW_AUTOMATION_PLANNING_SUGGESTION_API_KEY_ID=
# OPENCLAW_AUTOMATION_PLANNING_SUGGESTION_API_SECRET=

# Store distribuido server-only para rate limit y replay.
# Requiere token Standard porque ejecuta EVAL/INCR/SET con TTL.
# No completar valores reales en este archivo ni exponerlos al cliente.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Store dedicado del Bloque 5. No reutilizar el namespace ni las credenciales del Bloque 4.
# AUTOMATIONS_UPSTASH_REDIS_REST_URL=
# AUTOMATIONS_UPSTASH_REDIS_REST_TOKEN=
# AUTOMATIONS_STATE_ENCRYPTION_KEY=
AUTOMATIONS_STATE_NAMESPACE=vida2:automations:development:vida2-automations-v1

# Orquestador futuro. Los workflows y todas las fronteras nacen apagados.
# AUTOMATIONS_N8N_BASE_URL=
# AUTOMATIONS_N8N_WEBHOOK_SECRET=
AUTOMATIONS_MANUAL_RUN_ENABLED=false
AUTOMATIONS_RESULT_CALLBACK_ENABLED=false
# Set true only after Work tests all six units, both digest runners, signing and callback.
AUTOMATIONS_N8N_TEMPLATES_PROVISIONED=false

# Pausas operativas server-side adicionales a los kill switches de habilitación.
AUTOMATIONS_DAILY_BRIEFING_PAUSED=false
AUTOMATIONS_TECHNICAL_WATCHDOG_PAUSED=false
AUTOMATIONS_WEEKLY_REVIEW_PAUSED=false
AUTOMATIONS_APPROVAL_DIGEST_PAUSED=false
AUTOMATIONS_PLANNING_SUGGESTION_PAUSED=false