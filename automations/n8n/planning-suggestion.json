{
  "name": "Vida 2.0 · Sugerencia de planificación",
  "active": false,
  "nodes": [
    {
      "id": "planning-schedule",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "30 7 * * 1-5" }] }
      }
    },
    {
      "id": "planning-request",
      "name": "Controlled Vida2 proposal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDA2_CONTROLLED_API_BASE_URL + '/api/openclaw/v1/proposals' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-vida-key-id", "value": "={{ $json.keyId }}" },
            { "name": "x-vida-timestamp", "value": "={{ $json.timestamp }}" },
            { "name": "x-vida-request-id", "value": "={{ $json.requestId }}" },
            { "name": "x-vida-signature", "value": "={{ $json.signature }}" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}"
      }
    }
  ],
  "connections": {
    "Schedule": { "main": [[{ "node": "Controlled Vida2 proposal", "type": "main", "index": 0 }]] }
  },
  "settings": { "timezone": "America/Argentina/Cordoba", "executionOrder": "v1" },
  "versionId": "vida2-planning-suggestion-v1",
  "meta": {
    "contractVersion": "vida2-automations-v1",
    "workflowKey": "planning-suggestion",
    "operations": ["tasks.list", "calendar.upcoming", "task.create.propose"],
    "signatureProtocol": "vida2-openclaw-hmac-v2",
    "retryableStatusCodes": [429, 500, 502, 503, 504],
    "maxAttempts": 3
  }
}
