{
  "name": "Vida 2.0 · Sugerencia de planificación",
  "active": false,
  "nodes": [
    {
      "id": "planning-schedule",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "30 7 * * 1-5" }] }
      }
    },
    {
      "id": "planning-request",
      "name": "Controlled Vida2 proposal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDA2_CONTROLLED_API_BASE_URL + '/api/openclaw/v1/proposals' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-vida-key-id", "value": "={{ $json.keyId }}" },
            { "name": "x-vida-timestamp", "value": "={{ $json.timestamp }}" },
            { "name": "x-vida-request-id", "value": "={{ $json.requestId }}" },
            { "name": "x-vida-signature", "value": "={{ $json.signature }}" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}"
      }
    },
    {
      "id": "planning-callback",
      "name": "Controlled Vida2 callback (provisioning placeholder)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.VIDA2_CONTROLLED_API_BASE_URL + '/api/automations/v1/runs' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-vida-request-id", "value": "={{ $json.callbackRequestId }}" },
            {
              "name": "x-vida-automations-secret",
              "value": "={{ $env.VIDA2_AUTOMATIONS_CALLBACK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.callbackBody }}"
      }
    }
  ],
  "connections": {},
  "settings": { "timezone": "America/Argentina/Cordoba", "executionOrder": "v1" },
  "versionId": "vida2-planning-suggestion-v1",
  "meta": {
    "contractVersion": "vida2-automations-v1",
    "workflowKey": "planning-suggestion",
    "operations": ["tasks.list", "calendar.upcoming", "task.create.propose"],
    "signatureProtocol": "vida2-openclaw-hmac-v2",
    "idempotencyPolicy": "preserve-business-key",
    "requestAuthenticationPolicy": "regenerate-per-attempt",
    "retryableStatusCodes": [429, 500, 502, 503, 504],
    "maxAttempts": 3,
    "provisioningState": "requires-signing-helper",
    "executable": false,
    "callbackPath": "/api/automations/v1/runs"
  }
}
